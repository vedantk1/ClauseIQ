# Local development only. Copy to backend/.env; never commit the generated file.
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

MONGODB_URI=mongodb://localhost:27017
# New installs use clauseiq. Keep an existing installation's database name.
# Changing this selects another store; it does not rename or migrate data.
MONGODB_DATABASE=clauseiq
MONGODB_COLLECTION=documents
MONGODB_COLLECTION_PREFIX=

QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION=clauseiq-vectors
QDRANT_API_KEY=

MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=.pdf
STORAGE_DIR=./documents_storage

# Automatically generated private credential state, relative to backend.
# Back up this directory with MongoDB. It also pins the database name/prefix.
# No manually generated secrets needed; never delete state to bypass startup checks.
WORKSPACE_STATE_DIR=.local-only/workspace

# Enter your OpenAI key in application Settings, never in this file.
# No accounts, SMTP, JWT secrets or admin-email assignment are used.

# Initial model only; a saved workspace choice takes precedence.
OPENAI_DEFAULT_MODEL=gpt-6-sol
# Estimated complete input per generation request (not an account spend cap).
AI_MAX_INPUT_TOKENS=100000
# Optional AI_<TASK>_MAX_COMPLETION_TOKENS overrides include reasoning tokens.
# See docs/DEVELOPMENT.md for the supported task names and defaults.
# New source-backed review uses one call, default 16000 completion tokens.
# AI_REVIEW_MAX_COMPLETION_TOKENS=16000
# Library answers have separate task limits; search never triggers generation.
# AI_LIBRARY_ANSWER_MAX_INPUT_TOKENS=30000
# AI_LIBRARY_ANSWER_MAX_COMPLETION_TOKENS=6000
# AI_LIBRARY_ANSWER_TIMEOUT_SECONDS=120
# Total provider wait in seconds; values above 180 clamp to 180. No paid retries.
# AI_REVIEW_TIMEOUT_SECONDS=120
